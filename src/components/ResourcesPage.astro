---
import '../styles/global.css';
import '../styles/resources.css';
import githubCommunity from '../data/github-community.json';
import resourcesData from '../data/resources.json';
import { languages, type Language } from '../i18n/translations';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import SeoHead from './SeoHead.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const homePath = getLocalizedPath(Astro.url, lang, '/');
const aboutPath = getLocalizedPath(Astro.url, lang, '/about');
const resourcesPath = getLocalizedPath(Astro.url, lang, '/resources');

const formatStars = (stars?: number) => {
  if (!stars) return '';
  if (stars >= 1000) return `${(stars / 1000).toFixed(1)}k`;
  return String(stars);
};

const iconPaths: Record<string, string> = {
  image: 'M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm11 8l-5-6-4 5-3-3-4 4',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  'git-branch': 'M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm12-12c0 6-12 6-12 12',
  cpu: 'M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3M6 6h12v12H6V6Zm3 3h6v6H9V9Z',
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8Z',
  rocket: 'M4.5 16.5c-1.5 1.37-2 6-2 6s4.63-.5 6-2c.75-.75 1-2 .25-2.75S5.25 15.75 4.5 16.5ZM12 15l-3-3m3 3c2-2.5 4.5-7 2.5-12C9.5 6 5 8.5 2.5 11L12 15Zm0 0 4-1.5c2.5-2.5 5-7 3-12M14 5.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Z',
};

const brandItems = (resourcesData.brandAssets || []).map((item) => ({
  ...item,
  title: t(`resources.brand.${item.id}_title`),
  copy: t(`resources.brand.${item.id}_desc`),
  svgPath: iconPaths[item.icon] || iconPaths.image,
  tags: [item.tag, 'Spark Brand'],
}));

const blueprintItems = (resourcesData.blueprints || []).map((item) => ({
  ...item,
  title: t(`resources.blueprints.${item.id}_title`),
  copy: t(`resources.blueprints.${item.id}_desc`),
  svgPath: iconPaths[item.icon] || iconPaths.cpu,
  tags: [item.tag, 'Blueprint'],
}));

const relicItems = (resourcesData.relics || []).map((item) => ({
  ...item,
  title: item.name,
  copy: t(`resources.relics.${item.id}_desc`),
  svgPath: iconPaths[item.icon] || iconPaths.rocket,
  tags: [item.tag, 'Community Relic'],
}));

const guideItems = (resourcesData.guides || []).map((guide) => ({
  ...guide,
  title: t(`resources.guides.${guide.id}_title`),
  copy: t(`resources.guides.${guide.id}_desc`),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/spark/logo.png" />
    <SeoHead
      title={t('resources.meta.title')}
      description={t('resources.meta.description')}
      lang={lang}
    />
  </head>
  <body class="resources-page">
    <header class="site-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href={homePath} aria-label="Spark Relics home">
          <img src="/assets/spark/logo.png" alt="" />
          <span>Spark Relics</span>
        </a>

        <button class="menu-toggle icon-button" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>

        <div class="nav-links" data-nav-links>
          <a href={homePath}>{t('nav.home')}</a>
          <a href={`${homePath}#projects`}>{t('nav.projects')}</a>
          <a href={`${homePath}#community`}>{t('nav.community')}</a>
          <a class="active" href={resourcesPath}>{t('nav.resources')}</a>
          <a href={aboutPath}>{t('nav.about')}</a>
        </div>

        <div class="nav-actions">
          <div class="lang-picker" aria-label="Language selector">
            <button class="lang-picker-button" type="button" aria-haspopup="true">
              <span>{languages[lang]}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="lang-dropdown">
              {Object.entries(languages).map(([langCode, langName]) => (
                <a
                  class:list={['lang-dropdown-item', { active: lang === langCode }]}
                  href={getLocalizedPath(Astro.url, langCode as Language)}
                >
                  <span>{langName}</span>
                  <small>{langCode.toUpperCase()}</small>
                </a>
              ))}
            </div>
          </div>

          <button class="theme-toggle icon-button" type="button" aria-label={t('nav.theme_toggle')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z" /></svg>
          </button>
          <a class="github-button icon-button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer" aria-label="Spark Relics on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.26-4.55-1.12-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.73c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
          </a>
          <a class="button button-small" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">{t('nav.join')}</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero Section styled 1:1 like MainPage hero -->
      <section class="hero" id="home">
        <img class="hero-backdrop hero-backdrop-poster" src="/assets/spark/generated/hero-v2.jpg" alt="" aria-hidden="true" />
        <video class="hero-backdrop hero-backdrop-video" autoplay muted loop playsinline preload="metadata" poster="/assets/spark/generated/hero-v2.jpg" aria-hidden="true">
          <source src="/assets/bg.mp4" type="video/mp4" />
        </video>
        <div class="hero-lens-vignette" aria-hidden="true"></div>
        <div class="hero-stars" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1>{t('resources.hero.title_1')}</h1>
            <p class="eyebrow">{t('resources.hero.title_2')}</p>
            <p class="hero-description">{t('resources.hero.lead')}</p>

            <div class="hero-buttons">
              <a class="button" href="#relics">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
                {t('resources.relics.title')}
              </a>
              <a class="button button-secondary" href="#blueprints">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20" /></svg>
                {t('resources.blueprints.title')}
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 1: Community Relics (2-column layout) -->
      <section class="projects-section" id="relics">
        <div class="shell">
          <div class="res-section-heading">
            <div class="res-heading-left">
              <h2>{t('resources.relics.title')}<span aria-hidden="true">✦</span></h2>
              <p>{t('resources.relics.desc')}</p>
            </div>
            <a class="res-heading-link" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">→</span></a>
          </div>

          <div class="res-grid-2">
            {relicItems.map((project) => (
              <article class="project-card res-card">
                <div class="project-main">
                  <div class="res-card-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={project.svgPath} /></svg>
                  </div>
                  <div>
                    <h3>
                      <a href={project.url} target="_blank" rel="noreferrer">{project.title}</a>
                    </h3>
                    <p>{project.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                {project.stars ? (
                  <div class="project-stats">
                    <span><b aria-hidden="true">★</b> {formatStars(project.stars)} Stars</span>
                  </div>
                ) : null}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 2: Developer Blueprints (2-column layout) -->
      <section class="projects-section" id="blueprints">
        <div class="shell">
          <div class="res-section-heading">
            <div class="res-heading-left">
              <h2>{t('resources.blueprints.title')}<span aria-hidden="true">✦</span></h2>
              <p>{t('resources.blueprints.desc')}</p>
            </div>
            <a class="res-heading-link" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">GitHub Workflows <span aria-hidden="true">→</span></a>
          </div>

          <div class="res-grid-2">
            {blueprintItems.map((project) => (
              <article class="project-card res-card">
                <div class="project-main">
                  <div class="res-card-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={project.svgPath} /></svg>
                  </div>
                  <div>
                    <h3>
                      <a href={project.url} target="_blank" rel="noreferrer">{project.title}</a>
                    </h3>
                    <p>{project.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 3: Brand Assets (2-column layout) -->
      <section class="projects-section" id="brand">
        <div class="shell">
          <div class="res-section-heading">
            <div class="res-heading-left">
              <h2>{t('resources.brand.title')}<span aria-hidden="true">✦</span></h2>
              <p>{t('resources.brand.desc')}</p>
            </div>
            <a class="res-heading-link" href="/assets/spark/generated/hero-v2.jpg" target="_blank" download="spark-relics-4k-wallpaper.jpg">Download Kit <span aria-hidden="true">↓</span></a>
          </div>

          <div class="res-grid-2">
            {brandItems.map((project) => (
              <article class="project-card res-card">
                <div class="project-main">
                  <div class="res-card-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={project.svgPath} /></svg>
                  </div>
                  <div>
                    <h3>
                      <a href={project.url} target={project.downloadable ? '_blank' : '_self'} rel="noreferrer">{project.title}</a>
                    </h3>
                    <p>{project.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 4: Guides (3-column layout) -->
      <section class="projects-section" id="guides">
        <div class="shell">
          <div class="res-section-heading">
            <div class="res-heading-left">
              <h2>{t('resources.guides.title')}<span aria-hidden="true">✦</span></h2>
              <p>{t('resources.guides.desc')}</p>
            </div>
            <a class="res-heading-link" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">Docs <span aria-hidden="true">→</span></a>
          </div>

          <div class="res-grid-3">
            {guideItems.map((guide) => (
              <article class="project-card res-card">
                <div class="project-main">
                  <div class="res-card-number">
                    <span>{guide.number}</span>
                  </div>
                  <div>
                    <h3>
                      <a href={guide.url} target="_blank" rel="noreferrer">{guide.title}</a>
                    </h3>
                    <p>{guide.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  <span>Knowledge Guide</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA Stats Banner styled 1:1 like MainPage CTA -->
      <section class="cta shell">
        <div class="cta-panel">
          <img class="cta-backdrop" src="/assets/spark/generated/cta-v2.jpg" alt="" aria-hidden="true" />
          <div class="cta-copy">
            <div>
              <h2>{t('resources.stats.title')}</h2>
              <p>{t('resources.stats.desc')}</p>
            </div>
            <a class="button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
              {t('resources.stats.button')}
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="about-footer shell">
      <a class="brand" href={homePath}><img src="/assets/spark/logo.png" alt="" /><span>Spark Relics</span></a>
      <p>{t('about.footer.tagline')} · {year}</p>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const navLinks = document.querySelector('[data-nav-links]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        navLinks?.classList.toggle('open', !open);
      });

      document.querySelector('.theme-toggle')?.addEventListener('click', () => document.body.classList.toggle('soft-contrast'));
    </script>
  </body>
</html>
