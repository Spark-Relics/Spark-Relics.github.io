---
import '../styles/global.css';
import githubCommunity from '../data/github-community.json';
import { languages, type Language } from '../i18n/translations';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import SeoHead from './SeoHead.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const formatMetric = (value: number | string) => new Intl.NumberFormat(lang, {
  notation: Number(value) >= 1000 ? 'compact' : 'standard',
  maximumFractionDigits: 1,
}).format(Number(value) || 0).toLowerCase();

const creators = githubCommunity.members;

const communityStats = [
  { icon: 'people', value: formatMetric(githubCommunity.stats.creators), label: t('community.stat.members') },
  { icon: 'code', value: formatMetric(githubCommunity.stats.projects), label: t('community.stat.projects') },
  { icon: 'star', value: formatMetric(githubCommunity.stats.stars), label: t('community.stat.stars') },
  { icon: 'fork', value: formatMetric(githubCommunity.stats.contributors), label: t('community.stat.contributors') },
  { icon: 'globe', value: formatMetric(githubCommunity.stats.locations), label: t('community.stat.locations') },
];

const projects = githubCommunity.projects.map((project) => ({
  ...project,
  title: project.name,
  copy: project.description,
  tags: [project.language, project.private ? t('projects.tag_private') : (project.topics[0] || t('projects.tag_opensource'))],
}));

const heroStars = Array.from({ length: 30 }, (_, index) => ({
  x: (index * 37 + 11) % 100,
  y: (index * 53 + 7) % 82,
  size: 1 + (index % 3),
  delay: (index % 10) * -0.37,
  duration: 3.2 + (index % 6) * 0.48,
}));

const heroEmbers = Array.from({ length: 18 }, (_, index) => ({
  x: (index * 43 + 7) % 96,
  y: 42 + ((index * 29 + 9) % 52),
  size: 2 + (index % 4),
  delay: (index % 9) * -0.42,
}));

const homePath = getLocalizedPath(Astro.url, lang, '/');
const aboutPath = getLocalizedPath(Astro.url, lang, '/about');
const resourcesPath = getLocalizedPath(Astro.url, lang, '/resources');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/spark/logo.png" />
    <SeoHead
      title={`Spark Relics · ${t('hero.eyebrow')}`}
      description={`${t('hero.description_1')} ${t('hero.description_2')} ${t('hero.description_3')}`}
      lang={lang}
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href={homePath} aria-label="Spark Relics home">
          <img src="/assets/spark/logo.png" alt="" />
          <span>Spark Relics</span>
        </a>

        <button class="menu-toggle icon-button" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>

        <div class="nav-links" data-nav-links>
          <a class="active" href={homePath}>{t('nav.home')}</a>
          <a href="#projects">{t('nav.projects')}</a>
          <a href="#community">{t('nav.community')}</a>
          <a href={resourcesPath}>{t('nav.resources')}</a>
          <a href={aboutPath}>{t('nav.about')}</a>
        </div>

        <div class="nav-actions">
          <div class="lang-picker" aria-label="Language selector">
            <button class="lang-picker-button" type="button" aria-haspopup="true">
              <span>{languages[lang]}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="lang-dropdown">
              {Object.entries(languages).map(([langCode, langName]) => (
                <a
                  class:list={['lang-dropdown-item', { active: lang === langCode }]}
                  href={getLocalizedPath(Astro.url, langCode as Language)}
                >
                  <span>{langName}</span>
                  <small>{langCode.toUpperCase()}</small>
                </a>
              ))}
            </div>
          </div>

          <button class="theme-toggle icon-button" type="button" aria-label={t('nav.theme_toggle')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z" /></svg>
          </button>
          <a class="github-button icon-button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer" aria-label="Spark Relics on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.26-4.55-1.12-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.73c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
          </a>
          <button class="button button-small join-trigger" type="button">{t('nav.join')}</button>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" id="home">
        <img class="hero-backdrop hero-backdrop-poster" src="/assets/spark/generated/hero-v2.jpg" alt="" aria-hidden="true" />
        <video class="hero-backdrop hero-backdrop-video" autoplay muted loop playsinline preload="metadata" poster="/assets/spark/generated/hero-v2.jpg" aria-hidden="true">
          <source src="/assets/bg.mp4" type="video/mp4" />
        </video>
        <div class="parallax-scene" data-parallax-scene aria-hidden="true">
          <div class="parallax-layer star-layer" data-depth="0.14">
            {heroStars.map((star) => (
              <i class="parallax-star" style={`--star-x:${star.x}%;--star-y:${star.y}%;--star-size:${star.size}px;--star-delay:${star.delay}s;--star-duration:${star.duration}s`}></i>
            ))}
          </div>

          <div class="parallax-layer orbit-layer" data-depth="-0.28">
            <svg class="celestial-orbits" viewBox="0 0 820 620" role="presentation">
              <ellipse cx="430" cy="315" rx="332" ry="246" />
              <ellipse cx="430" cy="315" rx="272" ry="196" />
              <ellipse class="orbit-dashed" cx="430" cy="315" rx="302" ry="220" />
              <path d="M112 346c90-172 304-279 526-214" />
            </svg>
            <img class="parallax-planet planet-blue" src="/assets/spark/generated/parallax/planet-blue.png" alt="" />
            <img class="parallax-planet planet-amber" src="/assets/spark/generated/parallax/planet-amber.png" alt="" />
          </div>

          <div class="parallax-layer glow-layer" data-depth="0.24">
            <span class="relic-halo"></span>
            <span class="light-ray ray-one"></span>
            <span class="light-ray ray-two"></span>
          </div>

          <div class="parallax-layer mist-layer" data-depth="0.52">
            <span class="hero-mist mist-left"></span>
            <span class="hero-mist mist-right"></span>
          </div>

          <div class="parallax-layer ember-layer" data-depth="0.76">
            {heroEmbers.map((ember) => (
              <i class="hero-ember" style={`--ember-x:${ember.x}%;--ember-y:${ember.y}%;--ember-size:${ember.size}px;--ember-delay:${ember.delay}s`}></i>
            ))}
          </div>

          <div class="parallax-layer foreground-layer" data-depth="1.08">
            <img class="foreground-frame" src="/assets/spark/generated/parallax/foreground-crystals-v2.png" alt="" />
          </div>
        </div>
        <div class="hero-cursor-flare" data-cursor-flare aria-hidden="true"></div>
        <div class="hero-lens-vignette" aria-hidden="true"></div>
        <div class="hero-stars" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1>Spark Relics</h1>
            <p class="eyebrow">{t('hero.eyebrow')}</p>
            <p class="hero-description">{t('hero.description_1')}<br />{t('hero.description_2')}<br />{t('hero.description_3')}</p>

            <div class="hero-buttons">
              <a class="button" href="#projects">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
                {t('hero.explore')}
              </a>
              <button class="button button-secondary join-trigger" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM18 8v6M15 11h6" /></svg>
                {t('hero.join')}
              </button>
            </div>

            <div class="creator-proof">
              <div class="avatar-stack" aria-hidden="true">
                {creators.slice(0, 4).map((creator) => <img src={creator.avatarUrl} alt="" />)}
              </div>
              <span>{t('hero.meet_creators', { count: formatMetric(githubCommunity.stats.creators) })}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="community-showcase shell" id="community" aria-labelledby="creators-title">
        <div class="creator-panel" data-creator-strip>
          <div class="creator-intro">
            <h2 id="creators-title">{t('community.title')}<span aria-hidden="true">✦</span></h2>
            <p>{t('community.subtitle_1')}<br />{t('community.subtitle_2')}</p>
            <a href="https://github.com/orgs/Spark-Relics/people" target="_blank" rel="noreferrer">{t('community.view_all')} <span aria-hidden="true">→</span></a>
          </div>

          <div class="creator-carousel carousel" data-carousel="creators">
            <div class="creator-track carousel-track" tabindex="0" aria-label="Featured GitHub creators">
              {creators.map((creator) => {
                const isFounder = creator.role === 'Founder';
                return (
                  <button class:list={["creator-card", { "creator-card-founder": isFounder }]} type="button" data-github-user={creator.login} data-fallback-name={creator.name} data-community-role={creator.role} aria-haspopup="dialog" aria-label={`View ${creator.name}'s GitHub profile card`}>
                    <img src={creator.avatarUrl} alt={`${creator.name}'s GitHub avatar`} loading="lazy" />
                    <strong>{creator.name}</strong>
                    {isFounder && <span class="creator-role"><b aria-hidden="true">✦</b> Founder</span>}
                    {!isFounder && <span class="creator-metrics"><b title="Followers">●</b> {formatMetric(creator.followers)} <i title="Public repositories">◇</i> {formatMetric(creator.publicRepos)}</span>}
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <div class="community-stats" aria-label="Community statistics">
          {communityStats.map((stat) => (
            <div class="stat-item">
              <span class={`stat-icon stat-icon-${stat.icon}`} aria-hidden="true"></span>
              <span><strong>{stat.value}</strong><small>{stat.label}</small></span>
            </div>
          ))}
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="shell">
          <div class="section-heading">
            <h2>{t('projects.title')}<span aria-hidden="true">✦</span></h2>
            <a href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">{t('projects.view_all')} <span aria-hidden="true">→</span></a>
          </div>

          <div class="project-carousel carousel" data-carousel="projects">
            <button class="carousel-button project-prev" type="button" data-carousel-prev aria-label="Previous projects">‹</button>
            <div class="project-grid carousel-track" tabindex="0" aria-label="Featured open source projects">
              {projects.map((project) => (
              <article class:list={["project-card", { "project-card-private": project.private }]}>
                <div class="project-main">
                  <div class="project-icon"><img src={project.image} alt="" /></div>
                  <div>
                    <h3>{project.url ? <a href={project.url} target="_blank" rel="noreferrer">{project.title}</a> : project.title}{project.private && <span class="private-mark">{t('projects.tag_private')}</span>}</h3>
                    <p>{project.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="project-stats">
                  <span><b aria-hidden="true">★</b> {formatMetric(project.stars)}</span>
                  <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="19" r="2"/><path d="M6 7v10M8 8c5 0 4-2 8-2M8 17c5 0 4-5 8-5v-4"/></svg>
                    {formatMetric(project.forks)}
                  </span>
                </div>
              </article>
              ))}
            </div>
            <button class="carousel-button project-next" type="button" data-carousel-next aria-label="Next projects">›</button>
            <div class="carousel-dots" data-carousel-dots aria-label="Project pages"></div>
          </div>
        </div>
      </section>

      <section class="cta shell" id="about">
        <div class="cta-panel">
          <img class="cta-backdrop" src="/assets/spark/generated/cta-v2.jpg" alt="" aria-hidden="true" />
          <div class="cta-copy">
            <div>
              <h2>{t('cta.title')}</h2>
              <p>{t('cta.description_1')}<br />{t('cta.description_2')}</p>
            </div>
            <button class="button join-trigger" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
              {t('cta.button')}
            </button>
          </div>
        </div>
      </section>

      <div id="resources" aria-hidden="true"></div>
    </main>

    <dialog class="join-dialog">
      <button class="dialog-close icon-button" type="button" aria-label="Close dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <img src="/assets/spark/logo.png" alt="" />
      <p class="dialog-kicker">{t('dialog.join.kicker')}</p>
      <h2>{t('dialog.join.title')}</h2>
      <p>{t('dialog.join.description')}</p>
      <a class="button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">{t('dialog.join.button')} <span aria-hidden="true">→</span></a>
    </dialog>

    <dialog
      class="creator-dialog"
      aria-labelledby="creator-dialog-name"
      data-text-loading={t('dialog.creator.loading')}
      data-text-role-member={t('dialog.creator.role_member')}
      data-text-role-founder={t('dialog.creator.role_founder')}
      data-text-bio-fallback={t('dialog.creator.bio_fallback')}
    >
      <button class="profile-dialog-close icon-button" type="button" aria-label="Close creator profile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <div class="profile-card-shell">
        <aside class="profile-portrait">
          <div class="profile-avatar-orbit">
            <img data-profile-avatar src="/assets/spark/logo.png" alt="" />
          </div>
          <span class="profile-availability"><i aria-hidden="true"></i> {t('dialog.creator.profile_availability')}</span>
          <span class="profile-community-role" data-profile-role>{t('dialog.creator.role_member')}</span>
          <h2 id="creator-dialog-name" data-profile-name>Creator</h2>
          <a data-profile-login href="https://github.com" target="_blank" rel="noreferrer">@github</a>
        </aside>

        <section class="profile-content" aria-live="polite">
          <p class="dialog-kicker">{t('dialog.creator.kicker')}</p>
          <p class="profile-bio" data-profile-bio>{t('dialog.creator.loading')}</p>
          <div class="profile-meta">
            <span data-profile-location hidden><b aria-hidden="true">⌖</b><span></span></span>
            <span data-profile-company hidden><b aria-hidden="true">◈</b><span></span></span>
            <span data-profile-since hidden><b aria-hidden="true">✦</b><span></span></span>
          </div>
          <div class="profile-stats" aria-label="GitHub statistics">
            <span><strong data-profile-followers>—</strong><small>{t('dialog.creator.followers')}</small></span>
            <span><strong data-profile-following>—</strong><small>{t('dialog.creator.following')}</small></span>
            <span><strong data-profile-repos>—</strong><small>{t('dialog.creator.repos')}</small></span>
          </div>
          <p class="profile-error" data-profile-error hidden>{t('dialog.creator.error')}</p>
          <div class="profile-actions">
            <a class="button" data-profile-github href="https://github.com" target="_blank" rel="noreferrer">{t('dialog.creator.open_github')} <span aria-hidden="true">→</span></a>
            <a class="profile-blog" data-profile-blog href="#" target="_blank" rel="noreferrer" hidden>{t('dialog.creator.personal_site')} ↗</a>
          </div>
        </section>
      </div>
    </dialog>

    <script is:inline>
      const dialog = document.querySelector('.join-dialog');
      document.querySelectorAll('.join-trigger').forEach((trigger) => {
        trigger.addEventListener('click', () => dialog?.showModal());
      });
      document.querySelector('.dialog-close')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const creatorDialog = document.querySelector('.creator-dialog');
      const profileCache = new Map();
      let activeProfileRequest;

      const profileElements = creatorDialog ? {
        avatar: creatorDialog.querySelector('[data-profile-avatar]'),
        name: creatorDialog.querySelector('[data-profile-name]'),
        login: creatorDialog.querySelector('[data-profile-login]'),
        bio: creatorDialog.querySelector('[data-profile-bio]'),
        location: creatorDialog.querySelector('[data-profile-location]'),
        company: creatorDialog.querySelector('[data-profile-company]'),
        since: creatorDialog.querySelector('[data-profile-since]'),
        followers: creatorDialog.querySelector('[data-profile-followers]'),
        following: creatorDialog.querySelector('[data-profile-following]'),
        repos: creatorDialog.querySelector('[data-profile-repos]'),
        github: creatorDialog.querySelector('[data-profile-github]'),
        blog: creatorDialog.querySelector('[data-profile-blog]'),
        error: creatorDialog.querySelector('[data-profile-error]'),
        role: creatorDialog.querySelector('[data-profile-role]'),
      } : null;

      const setText = (element, value) => {
        if (element) element.textContent = String(value ?? '');
      };

      const setMeta = (element, value) => {
        if (!(element instanceof HTMLElement)) return;
        const content = element.querySelector('span');
        setText(content, value);
        element.hidden = !value;
      };

      const normalizeUrl = (value) => {
        if (!value) return null;
        try {
          const candidate = /^https?:\/\//i.test(value) ? value : `https://${value}`;
          const url = new URL(candidate);
          return ['http:', 'https:'].includes(url.protocol) ? url.href : null;
        } catch {
          return null;
        }
      };

      const renderProfile = (profile, fallbackName, communityRole = 'Member') => {
        if (!profileElements) return;
        const name = profile.name || fallbackName || profile.login;
        const githubUrl = normalizeUrl(profile.html_url) || `https://github.com/${profile.login}`;
        const blogUrl = normalizeUrl(profile.blog);
        const joined = profile.created_at ? `Joined ${new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(profile.created_at))}` : '';

        const roleTextMap = {
          Founder: creatorDialog.dataset.textRoleFounder,
          Member: creatorDialog.dataset.textRoleMember,
        };
        const roleText = roleTextMap[communityRole] || creatorDialog.dataset.textRoleMember;

        if (profileElements.avatar instanceof HTMLImageElement) {
          profileElements.avatar.src = profile.avatar_url || `https://github.com/${profile.login}.png?size=320`;
          profileElements.avatar.alt = `${name}'s GitHub avatar`;
        }
        setText(profileElements.name, name);
        setText(profileElements.role, roleText);
        setText(profileElements.login, `@${profile.login}`);
        setText(profileElements.bio, profile.bio || creatorDialog.dataset.textBioFallback);
        setText(profileElements.followers, Number(profile.followers ?? 0).toLocaleString());
        setText(profileElements.following, Number(profile.following ?? 0).toLocaleString());
        setText(profileElements.repos, Number(profile.public_repos ?? 0).toLocaleString());
        setMeta(profileElements.location, profile.location);
        setMeta(profileElements.company, profile.company);
        setMeta(profileElements.since, joined);

        if (profileElements.login instanceof HTMLAnchorElement) profileElements.login.href = githubUrl;
        if (profileElements.github instanceof HTMLAnchorElement) profileElements.github.href = githubUrl;
        if (profileElements.blog instanceof HTMLAnchorElement) {
          profileElements.blog.hidden = !blogUrl;
          if (blogUrl) profileElements.blog.href = blogUrl;
        }
      };

      document.querySelectorAll('[data-github-user]').forEach((card) => {
        card.addEventListener('click', async () => {
          if (!(creatorDialog instanceof HTMLDialogElement) || !profileElements || !(card instanceof HTMLElement)) return;
          const login = card.dataset.githubUser;
          if (!login) return;
          const fallbackName = card.dataset.fallbackName || login;
          const communityRole = card.dataset.communityRole || 'Member';
          const fallback = {
            login,
            name: fallbackName,
            avatar_url: `https://github.com/${login}.png?size=320`,
            html_url: `https://github.com/${login}`,
            bio: creatorDialog.dataset.textLoading,
            followers: 0,
            following: 0,
            public_repos: 0,
          };

          renderProfile(fallback, fallbackName, communityRole);
          profileElements.error?.toggleAttribute('hidden', true);
          creatorDialog.classList.add('is-loading');
          creatorDialog.showModal();

          try {
            activeProfileRequest?.abort();
            activeProfileRequest = new AbortController();
            const cached = profileCache.get(login);
            const profile = cached || await fetch(`https://api.github.com/users/${encodeURIComponent(login)}`, {
              signal: activeProfileRequest.signal,
              headers: {
                Accept: 'application/vnd.github+json',
                'X-GitHub-Api-Version': '2022-11-28',
              },
            }).then((response) => {
              if (!response.ok) throw new Error(`GitHub request failed: ${response.status}`);
              return response.json();
            });
            profileCache.set(login, profile);
            renderProfile(profile, fallbackName, communityRole);
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            profileElements.error?.removeAttribute('hidden');
          } finally {
            creatorDialog.classList.remove('is-loading');
          }
        });
      });

      document.querySelector('.profile-dialog-close')?.addEventListener('click', () => creatorDialog?.close());
      creatorDialog?.addEventListener('click', (event) => {
        if (event.target === creatorDialog) creatorDialog.close();
      });
      creatorDialog?.addEventListener('close', () => activeProfileRequest?.abort());

      const menu = document.querySelector('.menu-toggle');
      const links = document.querySelector('[data-nav-links]');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') === 'true';
        menu.setAttribute('aria-expanded', String(!open));
        links?.classList.toggle('open', !open);
      });
      links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        links.classList.remove('open');
        menu?.setAttribute('aria-expanded', 'false');
      }));

      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        document.body.classList.toggle('soft-contrast');
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const parallaxScene = document.querySelector('[data-parallax-scene]');
      const heroSection = document.querySelector('.hero');

      if (parallaxScene instanceof HTMLElement && heroSection instanceof HTMLElement && !reduceMotion.matches) {
        const parallaxLayers = Array.from(parallaxScene.querySelectorAll('[data-depth]'))
          .filter((layer) => layer instanceof HTMLElement)
          .map((layer) => ({ element: layer, depth: Number(layer.dataset.depth ?? '.2') }));

        let targetX = 0;
        let targetY = 0;
        let targetScroll = 0;
        let currentX = 0;
        let currentY = 0;
        let currentScroll = 0;
        let sceneActive = false;
        let animationFrame = 0;

        const renderParallax = () => {
          if (!sceneActive) return;
          currentX += (targetX - currentX) * .11;
          currentY += (targetY - currentY) * .11;
          currentScroll += (targetScroll - currentScroll) * .09;
          parallaxLayers.forEach(({ element, depth }) => {
            const x = currentX * depth * 172;
            const y = currentY * depth * 108 - currentScroll * depth * 230;
            const scale = 1 + Math.abs(depth) * .045 + Math.abs(currentX) * Math.abs(depth) * .018;
            const rotate = currentX * depth * 2.8;
            element.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale.toFixed(4)}) rotate(${rotate.toFixed(3)}deg)`;
          });

          const camera = heroSection.querySelector('.hero-backdrop-video');
          if (camera instanceof HTMLElement) {
            camera.style.setProperty('--camera-x', `${(-currentX * 27).toFixed(2)}px`);
            camera.style.setProperty('--camera-y', `${(-currentY * 17 - currentScroll * 38).toFixed(2)}px`);
            camera.style.setProperty('--camera-scale', `${(1.095 + currentScroll * .06).toFixed(4)}`);
          }

          const flare = heroSection.querySelector('[data-cursor-flare]');
          if (flare instanceof HTMLElement) {
            flare.style.setProperty('--flare-x', `${((currentX + 1) * 50).toFixed(2)}%`);
            flare.style.setProperty('--flare-y', `${((currentY + 1) * 50).toFixed(2)}%`);
          }
          animationFrame = requestAnimationFrame(renderParallax);
        };

        const startParallax = () => {
          if (sceneActive) return;
          sceneActive = true;
          cancelAnimationFrame(animationFrame);
          animationFrame = requestAnimationFrame(renderParallax);
        };

        const stopParallax = () => {
          sceneActive = false;
          cancelAnimationFrame(animationFrame);
        };

        heroSection.addEventListener('pointermove', (event) => {
          const bounds = heroSection.getBoundingClientRect();
          targetX = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - .5) * 2));
          targetY = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - .5) * 2));
        }, { passive: true });

        heroSection.addEventListener('pointerleave', () => {
          targetX = 0;
          targetY = 0;
        });

        const updateScrollDepth = () => {
          targetScroll = Math.max(0, Math.min(1, window.scrollY / Math.max(1, heroSection.offsetHeight)));
        };
        window.addEventListener('scroll', updateScrollDepth, { passive: true });
        updateScrollDepth();

        new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) startParallax();
          else stopParallax();
        }, { threshold: .03 }).observe(heroSection);
      }

      if (!reduceMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll('.creator-card, .project-card').forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.addEventListener('pointermove', (event) => {
            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            card.style.setProperty('--card-rx', `${((.5 - y) * 7).toFixed(2)}deg`);
            card.style.setProperty('--card-ry', `${((x - .5) * 9).toFixed(2)}deg`);
            card.style.setProperty('--shine-x', `${(x * 100).toFixed(1)}%`);
            card.style.setProperty('--shine-y', `${(y * 100).toFixed(1)}%`);
          }, { passive: true });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--card-rx', '0deg');
            card.style.setProperty('--card-ry', '0deg');
          });
        });
      }

      document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const track = carousel.querySelector('.carousel-track');
        const prev = carousel.querySelector('[data-carousel-prev]');
        const next = carousel.querySelector('[data-carousel-next]');
        const dots = carousel.querySelector('[data-carousel-dots]');
        if (!(track instanceof HTMLElement)) return;

        const pageSize = () => Math.max(1, track.clientWidth * .92);
        const pageCount = () => Math.max(1, Math.ceil(track.scrollWidth / pageSize()));
        let dotButtons = [];

        const renderDots = () => {
          if (!(dots instanceof HTMLElement)) return;
          dots.replaceChildren();
          dotButtons = Array.from({ length: pageCount() }, (_, index) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.setAttribute('aria-label', `Go to project page ${index + 1}`);
            button.addEventListener('click', () => track.scrollTo({ left: index * pageSize(), behavior: 'smooth' }));
            dots.append(button);
            return button;
          });
        };

        const update = () => {
          const current = Math.round(track.scrollLeft / pageSize());
          prev?.toggleAttribute('disabled', track.scrollLeft < 4);
          next?.toggleAttribute('disabled', track.scrollLeft + track.clientWidth >= track.scrollWidth - 4);
          dotButtons.forEach((dot, index) => dot.classList.toggle('active', index === current));
        };

        prev?.addEventListener('click', () => track.scrollBy({ left: -pageSize(), behavior: 'smooth' }));
        next?.addEventListener('click', () => track.scrollBy({ left: pageSize(), behavior: 'smooth' }));
        track.addEventListener('scroll', update, { passive: true });
        track.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          track.scrollBy({ left: event.key === 'ArrowLeft' ? -pageSize() : pageSize(), behavior: 'smooth' });
        });
        renderDots();
        update();
        new ResizeObserver(() => { renderDots(); update(); }).observe(track);
      });

      document.querySelectorAll('[data-github-user] img').forEach((image) => {
        image.addEventListener('error', () => {
          if (image instanceof HTMLImageElement) image.src = '/assets/spark/logo.png';
        }, { once: true });
      });

      const creatorStrip = document.querySelector('[data-creator-strip]');
      const creatorSection = document.querySelector('.community-showcase');
      const creatorMarquee = creatorStrip?.querySelector('.creator-track');

      if (creatorStrip instanceof HTMLElement && creatorSection instanceof HTMLElement && creatorMarquee instanceof HTMLElement) {
        const originalItems = Array.from(creatorMarquee.children);
        const marqueeStyle = getComputedStyle(creatorMarquee);
        const marqueeGap = Number.parseFloat(marqueeStyle.columnGap || marqueeStyle.gap) || 0;
        const originalItemsWidth = originalItems.reduce((total, item) => total + (item instanceof HTMLElement ? item.getBoundingClientRect().width : 0), 0);
        const originalContentWidth = originalItemsWidth + marqueeGap * Math.max(0, originalItems.length - 1);
        const loopWidth = originalItemsWidth + marqueeGap * originalItems.length;
        originalItems.forEach((item) => {
          const clone = item.cloneNode(true);
          if (!(clone instanceof HTMLElement)) return;
          clone.dataset.marqueeClone = '';
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('tabindex', '-1');
          clone.style.pointerEvents = 'none';
          clone.removeAttribute('data-github-user');
          clone.querySelectorAll('[tabindex], a, button').forEach((child) => {
            if (child instanceof HTMLElement) child.setAttribute('tabindex', '-1');
          });
          creatorMarquee.append(clone);
        });

        let marqueeFrame = 0;
        let scrollFrame = 0;
        let lastMarqueeTime = 0;
        let marqueePaused = false;
        let resumeTimer = 0;

        const updateCreatorFillMode = () => {
          const centered = originalContentWidth <= creatorMarquee.clientWidth - 4;
          creatorMarquee.classList.toggle('is-centered', centered);
          creatorStrip.classList.toggle('has-creator-overflow', !centered);
          if (centered) creatorMarquee.scrollLeft = 0;
          return centered;
        };

        const runMarquee = (time) => {
          if (!creatorStrip.classList.contains('is-pinned')) return;
          const elapsed = Math.min(40, time - (lastMarqueeTime || time));
          lastMarqueeTime = time;
          if (!marqueePaused && !reduceMotion.matches && !creatorMarquee.classList.contains('is-centered')) {
            creatorMarquee.scrollLeft += elapsed * .036;
            if (creatorMarquee.scrollLeft >= loopWidth) creatorMarquee.scrollLeft -= loopWidth;
          }
          marqueeFrame = requestAnimationFrame(runMarquee);
        };

        const startMarquee = () => {
          if (marqueeFrame || reduceMotion.matches || creatorMarquee.classList.contains('is-centered')) return;
          lastMarqueeTime = 0;
          marqueeFrame = requestAnimationFrame(runMarquee);
        };

        const stopMarquee = () => {
          cancelAnimationFrame(marqueeFrame);
          marqueeFrame = 0;
          lastMarqueeTime = 0;
        };

        const pauseMarquee = () => {
          marqueePaused = true;
          window.clearTimeout(resumeTimer);
        };

        const resumeMarquee = (delay = 350) => {
          window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(() => { marqueePaused = false; }, delay);
        };

        const updateCreatorScrollStage = () => {
          scrollFrame = 0;
          const stripRect = creatorStrip.getBoundingClientRect();
          const sectionRect = creatorSection.getBoundingClientRect();
          const stickyTop = 18;
          const expansionStart = window.innerHeight * .82;
          const progress = Math.max(0, Math.min(1, (expansionStart - stripRect.top) / Math.max(1, expansionStart - stickyTop)));
          const width = 87.5 + progress * 12.5;
          const radius = 22 - progress * 6;
          creatorStrip.style.setProperty('--creator-panel-width', `${width.toFixed(3)}%`);
          creatorStrip.style.setProperty('--creator-panel-radius', `${radius.toFixed(2)}px`);
          const centered = updateCreatorFillMode();

          const pinned = window.innerWidth > 760 && sectionRect.top <= stickyTop && sectionRect.bottom > creatorStrip.offsetHeight + stickyTop + 28;
          creatorStrip.classList.toggle('is-pinned', pinned);
          creatorSection.classList.toggle('has-pinned-strip', pinned);
          if (pinned && !centered) startMarquee();
          else stopMarquee();
        };

        const requestCreatorStageUpdate = () => {
          if (!scrollFrame) scrollFrame = requestAnimationFrame(updateCreatorScrollStage);
        };

        creatorMarquee.addEventListener('pointerenter', pauseMarquee);
        creatorMarquee.addEventListener('pointerleave', () => resumeMarquee());
        creatorMarquee.addEventListener('focusin', pauseMarquee);
        creatorMarquee.addEventListener('focusout', () => resumeMarquee());
        creatorMarquee.addEventListener('touchstart', pauseMarquee, { passive: true });
        creatorMarquee.addEventListener('touchend', () => resumeMarquee(1800), { passive: true });
        creatorMarquee.addEventListener('wheel', () => { pauseMarquee(); resumeMarquee(1800); }, { passive: true });
        window.addEventListener('scroll', requestCreatorStageUpdate, { passive: true });
        window.addEventListener('resize', requestCreatorStageUpdate, { passive: true });
        updateCreatorScrollStage();
      }
    </script>
  </body>
</html>
