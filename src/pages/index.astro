---
import '../styles/global.css';

const features = [
  { image: '/assets/spark/generated/feature-open-v2.jpg', title: 'Open Source', copy: 'We build and share open-source projects for everyone.' },
  { image: '/assets/spark/generated/feature-collaborate-v2.jpg', title: 'Collaborate', copy: 'We believe the best ideas come from working together.' },
  { image: '/assets/spark/generated/feature-learn-v2.jpg', title: 'Learn & Grow', copy: 'We document, teach and explore new technologies.' },
  { image: '/assets/spark/generated/feature-future-v2.jpg', title: 'Shape the Future', copy: 'Together, we create tools and ideas that matter.' },
];

const projects = [
  { image: '/assets/spark/generated/project-agent-v3.jpg', title: 'Relic Agent', copy: 'A framework for building autonomous AI agents.', tags: ['Python', 'AI Agent'], stars: '2.1k', forks: '364' },
  { image: '/assets/spark/generated/project-forge-v3.jpg', title: 'Spark Forge', copy: 'The ultimate toolkit for AI-driven development.', tags: ['TypeScript', 'Toolkit'], stars: '1.7k', forks: '289' },
  { image: '/assets/spark/generated/project-memory-v3.jpg', title: 'Memory Relic', copy: 'A memory system for LLM applications.', tags: ['Python', 'Database'], stars: '1.3k', forks: '212' },
  { image: '/assets/spark/generated/project-studio-v3.jpg', title: 'Relic Studio', copy: 'Create, visualize and share AI workflows easily.', tags: ['Web', 'Creative Tools'], stars: '982', forks: '156' },
];

const heroStars = Array.from({ length: 30 }, (_, index) => ({
  x: (index * 37 + 11) % 100,
  y: (index * 53 + 7) % 82,
  size: 1 + (index % 3),
  delay: (index % 10) * -0.37,
  duration: 3.2 + (index % 6) * 0.48,
}));

const heroEmbers = Array.from({ length: 18 }, (_, index) => ({
  x: (index * 43 + 7) % 96,
  y: 42 + ((index * 29 + 9) % 52),
  size: 2 + (index % 4),
  delay: (index % 9) * -0.42,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Spark Relics is a collective building open-source projects that leave a lasting mark." />
    <link rel="icon" type="image/png" href="/assets/spark/logo.png" />
    <title>Spark Relics</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href="#home" aria-label="Spark Relics home">
          <img src="/assets/spark/logo.png" alt="" />
          <span>Spark Relics</span>
        </a>

        <button class="menu-toggle icon-button" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>

        <div class="nav-links" data-nav-links>
          <a class="active" href="#home">Home</a>
          <a href="#projects">Projects</a>
          <a href="#community">Community</a>
          <a href="#resources">Resources</a>
          <a href="#about">About</a>
        </div>

        <div class="nav-actions">
          <button class="theme-toggle icon-button" type="button" aria-label="Toggle softer contrast">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z" /></svg>
          </button>
          <a class="github-button icon-button" href="https://github.com/Spark-Relics" aria-label="Spark Relics on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.26-4.55-1.12-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.73c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
          </a>
          <button class="button button-small join-trigger" type="button">Join Us</button>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" id="home">
        <img class="hero-backdrop hero-backdrop-poster" src="/assets/spark/generated/hero-v2.jpg" alt="" aria-hidden="true" />
        <video class="hero-backdrop hero-backdrop-video" autoplay muted loop playsinline preload="metadata" poster="/assets/spark/generated/hero-v2.jpg" aria-hidden="true">
          <source src="/assets/bg.mp4" type="video/mp4" />
        </video>
        <div class="parallax-scene" data-parallax-scene aria-hidden="true">
          <div class="parallax-layer star-layer" data-depth="0.14">
            {heroStars.map((star) => (
              <i class="parallax-star" style={`--star-x:${star.x}%;--star-y:${star.y}%;--star-size:${star.size}px;--star-delay:${star.delay}s;--star-duration:${star.duration}s`}></i>
            ))}
          </div>

          <div class="parallax-layer orbit-layer" data-depth="-0.28">
            <svg class="celestial-orbits" viewBox="0 0 820 620" role="presentation">
              <ellipse cx="430" cy="315" rx="332" ry="246" />
              <ellipse cx="430" cy="315" rx="272" ry="196" />
              <ellipse class="orbit-dashed" cx="430" cy="315" rx="302" ry="220" />
              <path d="M112 346c90-172 304-279 526-214" />
            </svg>
            <img class="parallax-planet planet-blue" src="/assets/spark/generated/parallax/planet-blue.png" alt="" />
            <img class="parallax-planet planet-amber" src="/assets/spark/generated/parallax/planet-amber.png" alt="" />
          </div>

          <div class="parallax-layer glow-layer" data-depth="0.24">
            <span class="relic-halo"></span>
            <span class="light-ray ray-one"></span>
            <span class="light-ray ray-two"></span>
          </div>

          <div class="parallax-layer mist-layer" data-depth="0.52">
            <span class="hero-mist mist-left"></span>
            <span class="hero-mist mist-right"></span>
          </div>

          <div class="parallax-layer ember-layer" data-depth="0.76">
            {heroEmbers.map((ember) => (
              <i class="hero-ember" style={`--ember-x:${ember.x}%;--ember-y:${ember.y}%;--ember-size:${ember.size}px;--ember-delay:${ember.delay}s`}></i>
            ))}
          </div>

          <div class="parallax-layer foreground-layer" data-depth="1.08">
            <img class="foreground-frame" src="/assets/spark/generated/parallax/foreground-crystals-v2.png" alt="" />
          </div>
        </div>
        <div class="hero-cursor-flare" data-cursor-flare aria-hidden="true"></div>
        <div class="hero-lens-vignette" aria-hidden="true"></div>
        <div class="hero-stars" aria-hidden="true"></div>
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1>Spark Relics</h1>
            <p class="eyebrow">Every spark becomes a relic</p>
            <p class="hero-description">We are a collective of creators and dreamers,<br />building open-source projects that leave<br />a lasting mark on the future.</p>

            <div class="hero-buttons">
              <a class="button" href="#projects">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
                Explore Projects
              </a>
              <button class="button button-secondary join-trigger" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM18 8v6M15 11h6" /></svg>
                Join Community
              </button>
            </div>

            <div class="creator-proof">
              <div class="avatar-stack" aria-hidden="true">
                {[1, 2, 3, 4].map((avatar) => <img src={`/assets/spark/avatar-${avatar}.png`} alt="" />)}
              </div>
              <span>Join 2,451+ creators worldwide</span>
            </div>
          </div>
        </div>
      </section>

      <section class="feature-section shell" id="community" aria-label="Our values">
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <div class="feature-image"><img src={feature.image} alt="" /></div>
              <h2>{feature.title}</h2>
              <p>{feature.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="shell">
          <div class="section-heading">
            <h2>Featured Projects<span aria-hidden="true">✦</span></h2>
            <a href="https://github.com/Spark-Relics">View all projects <span aria-hidden="true">→</span></a>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-main">
                  <div class="project-icon"><img src={project.image} alt="" /></div>
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.copy}</p>
                  </div>
                </div>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="project-stats">
                  <span><b aria-hidden="true">★</b> {project.stars}</span>
                  <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="19" r="2"/><path d="M6 7v10M8 8c5 0 4-2 8-2M8 17c5 0 4-5 8-5v-4"/></svg>
                    {project.forks}
                  </span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta shell" id="about">
        <div class="cta-panel">
          <img class="cta-backdrop" src="/assets/spark/generated/cta-v2.jpg" alt="" aria-hidden="true" />
          <div class="cta-copy">
            <div>
              <h2>Be Part of Something Meaningful</h2>
              <p>Whether you code, design, write, or dream – your spark can<br />become a relic that inspires the world.</p>
            </div>
            <button class="button join-trigger" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.25 5.31L20 9l-4.25 3.89L17 18.5 12 15.6 7 18.5l1.25-5.61L4 9l5.75-.69L12 3Z" /></svg>
              Join Us Today
            </button>
          </div>
        </div>
      </section>

      <div id="resources" aria-hidden="true"></div>
    </main>

    <dialog class="join-dialog">
      <button class="dialog-close icon-button" type="button" aria-label="Close dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <img src="/assets/spark/logo.png" alt="" />
      <p class="dialog-kicker">Find your spark</p>
      <h2>Join the community</h2>
      <p>Meet creators, share what you are building, and help shape the next relic.</p>
      <a class="button" href="https://github.com/Spark-Relics">Continue on GitHub <span aria-hidden="true">→</span></a>
    </dialog>

    <script>
      const dialog = document.querySelector('.join-dialog');
      document.querySelectorAll('.join-trigger').forEach((trigger) => {
        trigger.addEventListener('click', () => dialog?.showModal());
      });
      document.querySelector('.dialog-close')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const menu = document.querySelector('.menu-toggle');
      const links = document.querySelector('[data-nav-links]');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') === 'true';
        menu.setAttribute('aria-expanded', String(!open));
        links?.classList.toggle('open', !open);
      });
      links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        links.classList.remove('open');
        menu?.setAttribute('aria-expanded', 'false');
      }));

      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        document.body.classList.toggle('soft-contrast');
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const parallaxScene = document.querySelector('[data-parallax-scene]');
      const heroSection = document.querySelector('.hero');

      if (parallaxScene instanceof HTMLElement && heroSection instanceof HTMLElement && !reduceMotion.matches) {
        const parallaxLayers = Array.from(parallaxScene.querySelectorAll('[data-depth]'))
          .filter((layer) => layer instanceof HTMLElement)
          .map((layer) => ({ element: layer, depth: Number(layer.dataset.depth ?? '.2') }));

        let targetX = 0;
        let targetY = 0;
        let targetScroll = 0;
        let currentX = 0;
        let currentY = 0;
        let currentScroll = 0;
        let sceneActive = false;
        let animationFrame = 0;

        const renderParallax = () => {
          if (!sceneActive) return;
          currentX += (targetX - currentX) * .11;
          currentY += (targetY - currentY) * .11;
          currentScroll += (targetScroll - currentScroll) * .09;
          parallaxLayers.forEach(({ element, depth }) => {
            const x = currentX * depth * 172;
            const y = currentY * depth * 108 - currentScroll * depth * 230;
            const scale = 1 + Math.abs(depth) * .045 + Math.abs(currentX) * Math.abs(depth) * .018;
            const rotate = currentX * depth * 2.8;
            element.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale.toFixed(4)}) rotate(${rotate.toFixed(3)}deg)`;
          });

          const camera = heroSection.querySelector('.hero-backdrop-video');
          if (camera instanceof HTMLElement) {
            camera.style.setProperty('--camera-x', `${(-currentX * 27).toFixed(2)}px`);
            camera.style.setProperty('--camera-y', `${(-currentY * 17 - currentScroll * 38).toFixed(2)}px`);
            camera.style.setProperty('--camera-scale', `${(1.095 + currentScroll * .06).toFixed(4)}`);
          }

          const flare = heroSection.querySelector('[data-cursor-flare]');
          if (flare instanceof HTMLElement) {
            flare.style.setProperty('--flare-x', `${((currentX + 1) * 50).toFixed(2)}%`);
            flare.style.setProperty('--flare-y', `${((currentY + 1) * 50).toFixed(2)}%`);
          }
          animationFrame = requestAnimationFrame(renderParallax);
        };

        const startParallax = () => {
          if (sceneActive) return;
          sceneActive = true;
          cancelAnimationFrame(animationFrame);
          animationFrame = requestAnimationFrame(renderParallax);
        };

        const stopParallax = () => {
          sceneActive = false;
          cancelAnimationFrame(animationFrame);
        };

        heroSection.addEventListener('pointermove', (event) => {
          const bounds = heroSection.getBoundingClientRect();
          targetX = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - .5) * 2));
          targetY = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - .5) * 2));
        }, { passive: true });

        heroSection.addEventListener('pointerleave', () => {
          targetX = 0;
          targetY = 0;
        });

        const updateScrollDepth = () => {
          targetScroll = Math.max(0, Math.min(1, window.scrollY / Math.max(1, heroSection.offsetHeight)));
        };
        window.addEventListener('scroll', updateScrollDepth, { passive: true });
        updateScrollDepth();

        new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) startParallax();
          else stopParallax();
        }, { threshold: .03 }).observe(heroSection);
      }

      if (!reduceMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll('.feature-card, .project-card').forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.addEventListener('pointermove', (event) => {
            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            card.style.setProperty('--card-rx', `${((.5 - y) * 7).toFixed(2)}deg`);
            card.style.setProperty('--card-ry', `${((x - .5) * 9).toFixed(2)}deg`);
            card.style.setProperty('--shine-x', `${(x * 100).toFixed(1)}%`);
            card.style.setProperty('--shine-y', `${(y * 100).toFixed(1)}%`);
          }, { passive: true });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--card-rx', '0deg');
            card.style.setProperty('--card-ry', '0deg');
          });
        });
      }
    </script>
  </body>
</html>
