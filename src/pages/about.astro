---
import '../styles/global.css';
import '../styles/about.css';
import githubCommunity from '../data/github-community.json';

const founder = githubCommunity.members.find((member) => member.role === 'Founder') ?? githubCommunity.members[0];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The story behind Spark Relics: before the unknown arrives, we build meaningful work together and leave something worth remembering." />
    <link rel="icon" type="image/png" href="/assets/spark/logo.png" />
    <title>About · Spark Relics</title>
  </head>
  <body class="about-page">
    <header class="site-header about-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Spark Relics home">
          <img src="/assets/spark/logo.png" alt="" />
          <span>Spark Relics</span>
        </a>

        <button class="menu-toggle icon-button" type="button" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>

        <div class="nav-links" data-nav-links>
          <a href="/">Home</a>
          <a href="/#projects">Projects</a>
          <a href="/#community">Community</a>
          <a href="/#resources">Resources</a>
          <a class="active" href="/about/">About</a>
        </div>

        <div class="nav-actions">
          <button class="theme-toggle icon-button" type="button" aria-label="Toggle softer contrast">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z" /></svg>
          </button>
          <a class="github-button icon-button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer" aria-label="Spark Relics on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.26-4.55-1.12-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.73c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
          </a>
          <a class="button button-small" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">Join Us</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="about-hero" aria-labelledby="about-title">
        <div class="cinema-stage" data-cinema-stage>
          <img class="about-hero-art" src="/assets/spark/generated/about-origin-v1.png" alt="A circle of creators gathering their individual sparks into one luminous star" />
          <video class="about-hero-video" data-about-video autoplay muted loop playsinline preload="metadata" poster="/assets/spark/generated/about-origin-v1.png" aria-hidden="true">
            <source src="/assets/bg-about.mp4" type="video/mp4" />
          </video>
          <div class="cinema-light light-one" aria-hidden="true"></div>
          <div class="cinema-light light-two" aria-hidden="true"></div>
          <div class="cinema-flare" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="cinema-dust dust-far" aria-hidden="true"></div>
          <div class="cinema-dust dust-near" aria-hidden="true"></div>
          <div class="cinema-foreground" aria-hidden="true"></div>
        </div>
        <div class="about-hero-vignette" aria-hidden="true"></div>
        <div class="about-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="about-hero-copy shell" data-reveal>
          <div class="hero-sigil" aria-hidden="true"><span></span><i>✦</i><span></span></div>
          <h1 id="about-title">Before the future arrives,<br /><em>leave something behind.</em></h1>
          <p class="about-lead">We don’t know what AI will reshape.<br />But we know what we want to leave behind.</p>
          <a class="scroll-cue" href="#origin"><span>Read our story</span><i aria-hidden="true"></i></a>
        </div>
        <div class="scene-progress" aria-hidden="true"><i></i></div>
      </section>

      <section class="origin-section shell" id="origin">
        <div class="origin-story" data-reveal>
          <blockquote>
            “I don’t know what AI will make of this industry.<br />
            But before that day arrives, <strong>I want to leave something behind.</strong>”
          </blockquote>
          <div class="origin-body">
            <p>That thought became Spark Relics. A spark is the fleeting idea each of us carries; a relic is what we build together—work with enough meaning to outlast its moment.</p>
            <p>We chose a warm, storybook world not to escape technology, but to remember what lives behind it: real people, restless curiosity, and companions willing to build side by side.</p>
          </div>
        </div>

        <a class="founder-card" href={founder.profileUrl} target="_blank" rel="noreferrer" data-reveal>
          <div class="founder-glow" aria-hidden="true"></div>
          <img src={founder.avatarUrl} alt={`${founder.name || founder.login}'s GitHub avatar`} />
          <div>
            <span class="founder-role">Founder on GitHub</span>
            <h2>{founder.name || founder.login}</h2>
            <p>{founder.bio || 'Building sparks into relics.'}</p>
          </div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
      </section>

      <section class="manifesto-section">
        <div class="manifesto-head shell" data-reveal>
          <div class="manifesto-title"><span class="manifesto-star" aria-hidden="true">✦</span><h2>One light can be beautiful.<br /><em>Together, we shine further.</em></h2></div>
          <p>Great projects rarely come from a lone genius. They grow where different experiences collide, collaboration endures, and “my idea” becomes “our work.”</p>
        </div>
        <div class="belief-stage shell">
          <svg class="belief-current" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true">
            <path class="current-shadow" d="M40 145 C210 30 325 230 492 130 S770 30 920 138 S1095 210 1160 92" />
            <path class="current-light" d="M40 145 C210 30 325 230 492 130 S770 30 920 138 S1095 210 1160 92" />
          </svg>
          <div class="belief-grid">
          <article class="belief-point" data-reveal>
            <div class="belief-icon">
              <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="31"/><ellipse cx="60" cy="60" rx="49" ry="21"/><path d="M43 52c2-12 10-18 20-18 12 0 21 8 21 19 0 17-18 17-20 28"/><circle class="solid" cx="63" cy="94" r="3"/></svg>
            </div>
            <h3>Stay curious</h3>
            <p>We do not have to pretend we understand AI’s future. Keep exploring and keep making—the answers will emerge from the work.</p>
          </article>
          <article class="belief-point featured" data-reveal>
            <div class="belief-icon relic">
              <svg viewBox="0 0 120 120" aria-hidden="true"><path class="solid" d="m60 8 10 34 31-17-19 30 30 8-32 8 15 31-28-20-9 31-7-32-29 18 18-29-31-9 33-7-16-30 29 20Z"/><path d="M60 28v64M28 60h64M39 39l42 42M81 39 39 81"/></svg>
            </div>
            <h3>Make it real</h3>
            <p>Instead of waiting for the wave to define us, we create something real, useful, and worthy of being remembered.</p>
          </article>
          <article class="belief-point" data-reveal>
            <div class="belief-icon people">
              <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="30" r="12"/><circle cx="31" cy="65" r="12"/><circle cx="89" cy="65" r="12"/><path d="M60 42v29M41 61l19 10 19-10M31 77l29 22 29-22"/></svg>
            </div>
            <h3>Raise each other</h3>
            <p>One person’s spark is finite. By supporting one another and building in the open, we can illuminate something truly great.</p>
          </article>
          </div>
        </div>
      </section>

      <section class="symbol-section shell">
        <div class="symbol-visual" data-reveal>
          <div class="symbol-orbits" aria-hidden="true"><i></i><i></i><i></i></div>
          <img src="/assets/spark/logo.png" alt="Spark Relics logo" />
          <span class="symbol-spark spark-a"></span><span class="symbol-spark spark-b"></span><span class="symbol-spark spark-c"></span>
        </div>
        <div class="symbol-copy" data-reveal>
          <h2>Many hands raise one spark.<br />That became our symbol.</h2>
          <p>The center of our mark is not one person’s halo, but a star lifted by many. Every ray keeps its own direction, yet they all meet at a shared center.</p>
          <div class="symbol-legend">
            <span><i>✦</i><b>SPARK</b><small>Individual ideas</small></span>
            <span><i>◎</i><b>CIRCLE</b><small>An open collective</small></span>
            <span><i>◆</i><b>RELIC</b><small>Work that remains</small></span>
          </div>
        </div>
      </section>

      <section class="about-cta shell" data-reveal>
        <div>
          <h2>The next relic<br />may begin with your spark.</h2>
        </div>
        <div class="cta-actions">
          <a class="button" href="https://github.com/Spark-Relics" target="_blank" rel="noreferrer">Join the community <span>→</span></a>
          <a class="text-link" href="/#projects">Explore our projects <span>↗</span></a>
        </div>
      </section>
    </main>

    <footer class="about-footer shell"><a class="brand" href="/"><img src="/assets/spark/logo.png" alt="" /><span>Spark Relics</span></a><p>Every spark becomes a relic · {year}</p></footer>

    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const navLinks = document.querySelector('[data-nav-links]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        navLinks?.classList.toggle('open', !open);
      });

      document.querySelector('.theme-toggle')?.addEventListener('click', () => document.body.classList.toggle('soft-contrast'));

      const revealItems = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      }), { threshold: .16 });
      revealItems.forEach((item) => observer.observe(item));

      const hero = document.querySelector('.about-hero');
      const stage = document.querySelector('[data-cinema-stage]');
      const heroVideo = document.querySelector('[data-about-video]');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (heroVideo) {
        if (reduceMotion) {
          heroVideo.pause();
          heroVideo.removeAttribute('autoplay');
        } else {
          const showVideo = () => heroVideo.classList.add('video-ready');
          if (heroVideo.readyState >= 2) showVideo();
          else heroVideo.addEventListener('loadeddata', showVideo, { once: true });
        }
      }
      if (hero && stage && !reduceMotion) {
        hero.addEventListener('pointermove', (event) => {
          const rect = hero.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - .5;
          const y = (event.clientY - rect.top) / rect.height - .5;
          hero.style.setProperty('--pointer-x', String(x));
          hero.style.setProperty('--pointer-y', String(y));
        });
        hero.addEventListener('pointerleave', () => {
          hero.style.setProperty('--pointer-x', '0');
          hero.style.setProperty('--pointer-y', '0');
        });

        let ticking = false;
        const updateCamera = () => {
          const rect = hero.getBoundingClientRect();
          const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height)));
          hero.style.setProperty('--scene-scroll', progress.toFixed(4));
          ticking = false;
        };
        addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateCamera);
            ticking = true;
          }
        }, { passive: true });
        updateCamera();
      }
    </script>
  </body>
</html>
